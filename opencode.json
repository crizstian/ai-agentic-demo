{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-2.5-pro",
  "agents": {
    "build": {
      "model": "google/gemini-2.5-pro",
      "description": "Coding agent (Gemini 2.5 Pro — free)"
    },
    "plan": {
      "model": "google/gemini-2.5-pro",
      "description": "Planning agent (Gemini 2.5 Pro — free)"
    }
  },
  "mcp": {
    "harness": {
      "type": "remote",
      "url": "http://mcp-harness:8000/mcp",
      "enabled": true
    },
    "atlassian": {
      "type": "remote",
      "url": "http://mcp-atlassian:8000/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "http://mcp-github:8000/mcp",
      "enabled": true
    },
    "perplexity": {
      "type": "remote",
      "url": "http://mcp-perplexity:8000/mcp",
      "enabled": true
    },
    "obsidian": {
      "type": "remote",
      "url": "http://mcp-obsidian:8000/mcp",
      "enabled": true
    },
    "kubernetes": {
      "type": "remote",
      "url": "http://mcp-kubernetes:8000/mcp",
      "enabled": true
    },
    "chrome": {
      "type": "remote",
      "url": "http://mcp-chrome:8000/mcp",
      "enabled": true
    },
    "docker": {
      "type": "remote",
      "url": "http://mcp-docker:8000/mcp",
      "enabled": true
    },
    "terraform": {
      "type": "remote",
      "url": "http://mcp-terraform:8000/mcp",
      "enabled": true
    },
    "grafana": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@grafana/mcp-grafana"
      ],
      "environment": {
        "GRAFANA_URL": "{env:GRAFANA_URL}",
        "GRAFANA_API_KEY": "{env:GRAFANA_API_KEY}"
      },
      "enabled": true
    },
    "coworker": {
      "type": "remote",
      "url": "https://odin.coworker.ai/mcp",
      "enabled": true
    },
    "harness-docs": {
      "type": "remote",
      "url": "https://hdh.mcp.kapa.ai",
      "enabled": true
    },
    "gitlab": {
      "type": "remote",
      "url": "${GITLAB_MCP_URL:-https://gitlab.example.com/-/mcp}",
      "enabled": true
    }
  }
}
