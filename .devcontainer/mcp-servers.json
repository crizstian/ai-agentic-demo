{
  "harness": {
    "command": "harness-mcp-v2",
    "args": [],
    "env": {
      "HARNESS_API_KEY": "${containerEnv:HARNESS_API_KEY}",
      "HARNESS_ACCOUNT_ID": "${containerEnv:HARNESS_ACCOUNT_ID}",
      "HARNESS_ORG": "${containerEnv:HARNESS_ORG}",
      "HARNESS_PROJECT": "${containerEnv:HARNESS_PROJECT}",
      "HARNESS_BASE_URL": "${containerEnv:HARNESS_BASE_URL}",
      "HARNESS_TOOLSETS": "${containerEnv:HARNESS_TOOLSETS}",
      "HARNESS_AUTO_APPROVE_RISK": "${containerEnv:HARNESS_AUTO_APPROVE_RISK}",
      "HARNESS_PIPELINE_VERSION": "${containerEnv:HARNESS_PIPELINE_VERSION}",
      "HARNESS_API_TIMEOUT_MS": "${containerEnv:HARNESS_API_TIMEOUT_MS}",
      "LOG_LEVEL": "${containerEnv:LOG_LEVEL}"
    }
  },
  "github": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-github"
    ],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "${containerEnv:GITHUB_PERSONAL_ACCESS_TOKEN}"
    }
  },
  "perplexity": {
    "command": "npx",
    "args": [
      "-y",
      "@perplexity-ai/mcp-server"
    ],
    "env": {
      "PERPLEXITY_API_KEY": "${containerEnv:PERPLEXITY_API_KEY}"
    }
  },
  "obsidian": {
    "command": "npx",
    "args": [
      "-y",
      "mcp-obsidian",
      "/workspace/obsidian"
    ],
    "env": {}
  },
  "kubernetes": {
    "command": "npx",
    "args": [
      "-y",
      "mcp-server-kubernetes"
    ],
    "env": {
      "KUBECONFIG": "${containerEnv:KUBECONFIG}"
    }
  },
  "chrome": {
    "command": "npx",
    "args": [
      "-y",
      "chrome-devtools-mcp@latest",
      "--browserUrl",
      "${CHROME_DEVTOOLS_URL:-http://host.docker.internal:9222}"
    ],
    "env": {}
  },
  "docker": {
    "command": "docker",
    "args": [
      "run",
      "-i",
      "--rm",
      "-v",
      "/var/run/docker.sock:/var/run/docker.sock",
      "docker/mcp-gateway"
    ],
    "env": {}
  },
  "terraform": {
    "command": "docker",
    "args": [
      "run",
      "-i",
      "--rm",
      "hashicorp/terraform-mcp-server:latest"
    ],
    "env": {}
  },
  "grafana": {
    "command": "npx",
    "args": [
      "-y",
      "@grafana/mcp-grafana"
    ],
    "env": {
      "GRAFANA_URL": "${containerEnv:GRAFANA_URL}",
      "GRAFANA_API_KEY": "${containerEnv:GRAFANA_API_KEY}"
    }
  }
}
