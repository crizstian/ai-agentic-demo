# =============================================================================
# AI Development Environment — Environment Variables
# =============================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env — it contains secrets. Only .env.example is committed.
# =============================================================================

# --- Harness Platform ---
HARNESS_API_KEY="<your-harness-pat>"
HARNESS_ACCOUNT_ID="<your-account-id>"
HARNESS_ORG="<your-org>"
HARNESS_PROJECT="<your-project>"
HARNESS_BASE_URL="https://app.harness.io"
# Available toolsets (comma-separated, default: all). 30 toolsets with 139 resource types.
# Engineering: platform,pipelines,services,environments,connectors,infrastructure,
#   secrets,logs,audit,delegates,repositories,registries,templates,pull-requests,
#   governance,freeze,overrides,settings,agent-pipelines
# GitOps: gitops
# Security: sto,scs
# Insights & GTM: sei,dashboards,ccm,idp (DORA metrics, cost management, developer portal)
# Feature Flags: feature-flags
# Chaos Engineering: chaos
# IaC/DB/AI: iacm,dbops,ai-evals,ansible,incidents,knowledge-graph,semantic-layer,file_store
HARNESS_TOOLSETS="all"
HARNESS_AUTO_APPROVE_RISK="all"
HARNESS_PIPELINE_VERSION="0"
HARNESS_API_TIMEOUT_MS="30000"
LOG_LEVEL="info"

# --- Claude Code / Vertex AI ---
CLAUDE_CODE_USE_VERTEX=1
CLOUD_ML_REGION="us-east5"
ANTHROPIC_VERTEX_PROJECT_ID="<your-gcp-project>"

# --- Perplexity ---
PERPLEXITY_API_KEY="<your-perplexity-key>"

# --- Chrome DevTools MCP (optional) ---
CHROME_DEVTOOLS_URL="http://host.docker.internal:9222"

# --- Obsidian vault (optional — override mount path in docker-compose) ---
# OBSIDIAN_VAULT_PATH="${HOME}/Obsidian/Harness"

# --- GCP / Kubernetes ---
GOOGLE_CLOUD_PROJECT="<your-gcp-project>"
KUBECONFIG="/home/devuser/.kube/config"

# --- Git ---
GIT_USER_NAME="<your-name>"
GIT_USER_EMAIL="<your-email>"

# --- GitHub ---
GITHUB_PERSONAL_ACCESS_TOKEN="<your-github-pat>"
GH_TOKEN="<your-github-pat>"

# --- GitLab MCP (optional — requires GitLab 18.6+ with native MCP) ---
# GITLAB_MCP_URL="https://gitlab.your-org.com/-/mcp"

# --- Grafana MCP (optional) ---
# GRAFANA_URL="https://grafana.your-org.com"
# GRAFANA_API_KEY="<your-grafana-api-key>"

# --- Google Gemini (for opencode — free tier) ---
# Get key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY="<your-google-ai-studio-key>"

# --- AWS (optional — for AWS CLI and AWS MCP servers) ---
# AWS_PROFILE="default"
# AWS_REGION="us-east-1"

# --- Security (ShiftLeft / Harness STO) ---
# SHIFTLEFT_ACCESS_TOKEN="<your-shiftleft-token>"
# SHIFTLEFT_ORG_ID="<your-shiftleft-org>"
