            "url": "{{baseUrl}}/api/ai/chat",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"message\": \"What is my account balance?\", \"session_id\": \"newman-traffic-001\"}"
            }
          }
        },
        {
          "name": "AI Chat - Transaction History",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/ai/chat",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"message\": \"Show me my recent transactions\", \"session_id\": \"newman-traffic-002\"}"
            }
          }
        },
        {
          "name": "AI Chat - FX Question",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/ai/chat",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"message\": \"What are today's exchange rates for EUR?\", \"session_id\": \"newman-traffic-003\"}"
            }
          }
